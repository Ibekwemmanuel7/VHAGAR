  "dist_tx_robust_km": {
   "name": "dist_tx_robust_km",
   "source": "HIFLD Transmission Lines (archived 2025)",
   "vintage": "2025",
   "method": "as dist_tx_km but excluding short lines (< 15 km) that end within 2 km of any USPVDB footprint (probable generator ties)",
   "leakage": "moderate",
   "note": "conservative: also removes some genuine pre-existing lines near facilities"
  },
  "dist_tx_hv_km": {
   "name": "dist_tx_hv_km",
